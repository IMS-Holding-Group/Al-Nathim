# مفتاح OpenRouter API (المزوّد الأساسي)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# مفتاح Google Gemini API (بديل اختياري)
GEMINI_API_KEY=your_gemini_api_key_here

# المزوّد المفضل: openrouter أو gemini
AI_PROVIDER=openrouter

# اسم نموذج OpenRouter (openrouter/free يوجّه لنموذج مجاني متاح)
OPENROUTER_MODEL=openrouter/free

# اسم نموذج Gemini (يُستخدم عند اختيار gemini أو كبديل)
GEMINI_MODEL=gemini-2.0-flash

# معرّف المشروع في رؤوس طلبات OpenRouter
OPENROUTER_SITE_URL=http://localhost:5000
OPENROUTER_APP_NAME=Al-Nathim

# مفتاح سرّي لجلسات Flask (غيّره في ملف .env الحقيقي)
SECRET_KEY=change_this_to_a_long_random_secret
